# Caddyfile for the hosted Orgo MCP server.
#
# Terminates TLS for the apex (`mcp.orgo.space`) and every tenant subdomain
# (`{tenant}.mcp.orgo.space`), and reverse-proxies to the Node app on
# 127.0.0.1:3333. This file mirrors what the infra module writes to
# /opt/orgo-mcp/Caddyfile on the box (orgo-infrastructure, modules/mcp-server/
# user-data.sh.tpl); keep the two in sync.
#
# TLS:
#   - Tenant subdomains share ONE wildcard certificate for `*.mcp.orgo.space`.
#     Let's Encrypt only issues wildcards through the DNS-01 challenge, so
#     Caddy needs a Cloudflare API token (Zone:Read + DNS:Edit on orgo.space)
#     in the container env as CLOUDFLARE_API_TOKEN, and a Caddy build that
#     includes the caddy-dns/cloudflare plugin (the stock `caddy:2` image does
#     NOT; use ghcr.io/caddybuilds/caddy-cloudflare or an xcaddy build).
#   - The apex keeps a plain per-host certificate via HTTP-01. A wildcard does
#     not cover the apex, and HTTP-01 needs no credentials.
#
# Without the wildcard, every tenant would need its own site block here plus
# a Caddy reload - which is exactly how customers ended up with a TLS
# handshake failure on the address the app hands them.

{
	email infra@orgo.space
	# Set ORGO_MCP_ACME_ENDPOINT to https://acme-staging-v02.api.letsencrypt.org/directory
	# when iterating on this Caddyfile to avoid hitting Let's Encrypt rate limits.
	acme_ca {$ORGO_MCP_ACME_ENDPOINT:https://acme-v02.api.letsencrypt.org/directory}
	log {
		output stdout
		format json
		level INFO
	}
}

# Shared snippet so the apex and the wildcard stay identical.
(mcp_site) {
	# Security headers. CORS itself is handled by the Node app (header values
	# vary per response there); these are response-shaping headers that apply
	# uniformly.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# MCP traffic is JSON or SSE - no inline scripts ever leave this server
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		# Don't advertise upstream tech
		-Server
		-X-Powered-By
	}

	# Tight request size limit at the edge - MCP messages are small. Defends
	# the Node process from absurd payloads before they're parsed.
	request_body {
		max_size 4MB
	}

	reverse_proxy 127.0.0.1:3333 {
		# Pass through the original host so the Node app can derive tenant.
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-For {remote_host}

		# Streamable HTTP / SSE: don't buffer responses, don't close on idle.
		flush_interval -1

		# Generous timeouts for long-running tool calls; the app's per-request
		# timeout (ORGO_TIMEOUT_MS=30000 by default) is the real bound.
		transport http {
			read_timeout 5m
			write_timeout 5m
			dial_timeout 5s
		}
	}
}

# Every tenant subdomain, one wildcard certificate (DNS-01 via Cloudflare).
*.mcp.orgo.space {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		# Ask Cloudflare's own resolvers when checking TXT propagation, not the
		# box's resolver, which may cache a stale answer past the ACME timeout.
		resolvers 1.1.1.1 1.0.0.1
	}
	import mcp_site
}

# Apex - the address tenants on a custom domain get from the app, and the
# /healthz target for uptime monitors. Per-host HTTP-01 certificate.
mcp.orgo.space {
	import mcp_site
}
